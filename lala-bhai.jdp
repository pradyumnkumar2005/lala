pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/lala.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                 dir('backend') {
                   sh sh '''mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \\
  -Dsonar.projectKey=lala-test \\
  -Dsonar.projectName=\'lala-test\' \\
  -Dsonar.host.url=http://13.234.230.244:9000 \\
  -Dsonar.token=sqp_7e22754a2cbd373c2327e84434cd90d1ca7958d3'''
                 }

                echo 'TEST SUCCESS'
            }
        }

        stage('DEPLOY') {
            steps { 
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
