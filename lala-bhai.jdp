pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/lala.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(installationName: 'lala-test', credentialsId: 'lala-test') {
                 dir('backend') {
                   sh sh '''mvn clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \\
  -Dsonar.projectKey=lala-test \\
  -Dsonar.projectName=\'lala-test\' \\'''
                 }
                } 
                echo 'TEST SUCCESS'
            }
        }

        stage('DEPLOY') {
            steps { 
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
