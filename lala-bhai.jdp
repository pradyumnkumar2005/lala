pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/lala.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                 dir('backend') {
                   sh '''sh \'\'\' mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar   
-Dsonar.projectKey=test-project   
-Dsonar.projectName=\\\'test-project\\\'   
-Dsonar.host.url=http://13.234.230.244:9000   
-Dsonar.token=sqp_ce94b566317b3803828310876a2a38b1350ecd56\'\'\''''
                 }

                echo 'TEST SUCCESS'
            }
        }

        stage('DEPLOY') {
            steps { 
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
