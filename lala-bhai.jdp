pipeline {
    agent any

    stages {

        stage('PULL') {
            steps {
                git 'https://github.com/pradyumnkumar2005/lala.git'
                echo 'PULL SUCCESS'
            }
        }

        stage('BUILD') {
            steps {
                dir('backend') {
                    sh 'mvn clean package -DskipTests'
                }
                echo 'BUILD SUCCESS'
            }
        }

        stage('TEST') {
            steps {
                withSonarQubeEnv(
                    installationName: 'lala',
                    credentialsId: 'lala-test'
                ) {
                    dir('backend') {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.9.0.7382:sonar -Dsonar.projectKey=lala-test -Dsonar.projectName=lala-test
                        '''
                    }
                }
                echo 'TEST SUCCESS'
            }
        }
        stage('QUALITY-GATE') {
            steps {
	        timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'lala-test'
                echo 'QUALITY-PASSED'
                }

                echo  'QUALITY-PASSED'                 
	    }    
        }

        stage('DEPLOY') {
            steps {
                echo 'DEPLOY SUCCESS'
            }
        }
    }
}
